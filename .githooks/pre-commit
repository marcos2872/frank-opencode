#!/bin/sh
# Pre-commit: block commits that fail formatting, lint or the test suite.
# Enable once per clone:  git config core.hooksPath .githooks
# Skip in an emergency:    git commit --no-verify
set -e

echo "pre-commit: cargo fmt --all --check"
cargo fmt --all --check

echo "pre-commit: cargo clippy -- -D warnings"
cargo clippy --all-targets -- -D warnings

echo "pre-commit: cargo test --all-targets"
cargo test --all-targets

echo "pre-commit: ok"
